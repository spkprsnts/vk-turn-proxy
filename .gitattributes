# Normalize line endings to LF in the repository
* text=auto eol=lf

# Go source files always LF
*.go text eol=lf

# Shell scripts always LF
*.sh text eol=lf

# Windows batch files use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binaries — no conversion
*.exe binary
*.dll binary
*.so binary
*.a binary
