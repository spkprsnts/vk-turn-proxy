# All text files: auto-detect, store and checkout with LF
* text=auto eol=lf

# Go ecosystem
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf

# Scripts
*.sh text eol=lf

# Config / CI
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
Dockerfile text eol=lf
.gitignore text eol=lf

# Windows batch files — keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binaries — no conversion
*.exe binary
*.dll binary
*.so binary
*.a binary
